# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Distribution / packaging
.eggs/
*.egg-info/
dist/
build/
wheels/
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
.env.bak
.python-version

# ─── Environment & Secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ─── Database ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Uploads & Generated Data ────────────────────────────────────
uploads/
data/grafo.json
data/embeddings.json

# ─── Alembic ─────────────────────────────────────────────────────
# Keep migrations tracked; ignore only the autogenerated cache
alembic/__pycache__/
alembic/versions/__pycache__/

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/
*.out

# ─── Testing & Coverage ──────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/

# ─── Type Checkers / Linters ─────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json

# ─── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── spaCy Models ────────────────────────────────────────────────
# Downloaded spaCy language models are large binaries
# Re-download via: python -m spacy download <model>
/en_core_web_*/
/es_core_news_*/

# ─── IDEs & Editors ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
desktop.ini
$RECYCLE.BIN/
